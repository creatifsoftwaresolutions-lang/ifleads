# App
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm

# Auth
JWT_ACCESS_SECRET=change-me-to-a-64-char-secret-key-please-replace-this-value
JWT_REFRESH_SECRET=change-me-to-a-64-char-secret-key-please-replace-this-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=localhost

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Meta / WhatsApp
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=crm-documents
